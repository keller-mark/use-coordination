exports[`usecoord > authoring workflow > builds the spec from the README 1`] = `
"$ usecoord init --key my-spec
$ usecoord add-view v1
$ usecoord add-view v2
$ usecoord add-view v3
$ usecoord link-views myValue --views v1 v2 --scope myValueScope1 --value 99
$ usecoord add-coordination myValue --scope myValueScope2 --value 20
$ usecoord use-coordination v3 myValue myValueScope2
$ usecoord set-coordination-value myValue myValueScope2 21
$ usecoord validate
  stderr| Valid
stdout:
  {
    "key": "my-spec",
    "coordinationSpace": {
      "myValue": {
        "myValueScope1": 99,
        "myValueScope2": 21
      }
    },
    "viewCoordination": {
      "v1": {
        "coordinationScopes": {
          "myValue": "myValueScope1"
        }
      },
      "v2": {
        "coordinationScopes": {
          "myValue": "myValueScope1"
        }
      },
      "v3": {
        "coordinationScopes": {
          "myValue": "myValueScope2"
        }
      }
    }
  }
exit code: 0
"
`;

