exports[`usecoord > link-views-by-object > attaches the scopes directly to the views with --no-meta 1`] = `
"$ usecoord link-views-by-object --views spatial --input '{"spatialImageLayer":{"$CL":[{"fileUid":"my-image","spatialLayerVisible":true,"spatialImageChannel":{"$CL":[{"spatialTargetC":0,"spatialChannelColor":[255,0,0]},{"spatialTargetC":1,"spatialChannelColor":[0,255,0]}]}}]}}' --no-meta
stdout:
  {
    "coordinationSpace": {
      "spatialImageLayer": {
        "A": "__dummy__"
      },
      "fileUid": {
        "A": "my-image"
      },
      "spatialLayerVisible": {
        "A": true
      },
      "spatialImageChannel": {
        "A": "__dummy__",
        "B": "__dummy__"
      },
      "spatialTargetC": {
        "A": 0,
        "B": 1
      },
      "spatialChannelColor": {
        "A": [
          255,
          0,
          0
        ],
        "B": [
          0,
          255,
          0
        ]
      }
    },
    "viewCoordination": {
      "spatial": {
        "coordinationScopes": {
          "spatialImageLayer": [
            "A"
          ]
        },
        "coordinationScopesBy": {
          "spatialImageLayer": {
            "fileUid": {
              "A": "A"
            },
            "spatialLayerVisible": {
              "A": "A"
            },
            "spatialImageChannel": {
              "A": [
                "A",
                "B"
              ]
            }
          },
          "spatialImageChannel": {
            "spatialTargetC": {
              "A": "A",
              "B": "B"
            },
            "spatialChannelColor": {
              "A": "A",
              "B": "B"
            }
          }
        }
      }
    }
  }
exit code: 0
"
`;

